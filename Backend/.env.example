# RentGuard Backend Environment Configuration Example
# Copy this file to .env and replace the values with your actual configuration.

PORT=5000
NODE_ENV=development

# Database
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/rentguard

# Authentication & Security
JWT_SECRET_KEY=your_jwt_secret_key_here
OTP_SECRET_KEY=your_otp_secret_key_here

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_FROM_EMAIL=your_verified_sender@domain.com

# Admin Account
ADMIN_EMAIL=admin@rentguard.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=RentGuard Admin

# Contact Form Recipient
CONTACT_TO_EMAIL=support@rentguard.com

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
